# MLB VIP Model — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────
SPORTSODDS_API_KEY=your_api_key_here

# ── Database & Storage ────────────────────────────────────────────
# MLB_DB_PATH=database/mlb_model.db
# MLB_CACHE_PATH=data/_api_cache
# MLB_OUTPUT_DIR=output
# MLB_BACKUP_DIR=backups

# ── Application ───────────────────────────────────────────────────
# MLB_ENVIRONMENT=production
# MLB_TIMEZONE=America/New_York
# MLB_FRESHNESS_THRESHOLD=3600

# ── Scheduler ─────────────────────────────────────────────────────
# MLB_SCHEDULER_ENABLED=true
# MLB_SCHEDULER_TIMEZONE=America/New_York

# ── Shadow Mode ───────────────────────────────────────────────────
# MLB_SHADOW_MODE=true

# ── Backup ────────────────────────────────────────────────────────
# MLB_BACKUP_RETENTION=7
# MLB_BACKUP_COMPRESSION=true
# MLB_BACKUP_SCHEDULE=0 3 * * *

# ── Delivery (disabled by default) ────────────────────────────────
# MLB_DELIVERY_CHANNELS=none
# MLB_DISCORD_WEBHOOKS=
# MLB_SPREADSHEET_ID=
# MLB_GOOGLE_CREDENTIALS=

# ── Filtering ─────────────────────────────────────────────────────
# MLB_MIN_CONFIDENCE=40.0
# MLB_MIN_EV=2.0
# MLB_ENABLED_MARKETS=all

# ── Logging ───────────────────────────────────────────────────────
# MLB_LOG_LEVEL=INFO
# MLB_LOG_FORMAT=human
